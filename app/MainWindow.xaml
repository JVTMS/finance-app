<Window x:Class="Finance.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FINANCE — Patrimônio &amp; Finanças"
        Width="1440" Height="920" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#050505">
    <Grid>
        <!-- tela de inicialização -->
        <Grid x:Name="LoadingPanel" Background="#050505">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Width="52" Height="52" Stroke="#3a3220" StrokeThickness="3"
                         Margin="0,0,0,22">
                    <Ellipse.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="Black" Offset="0.35"/>
                            <GradientStop Color="Transparent" Offset="0.85"/>
                        </LinearGradientBrush>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <TextBlock x:Name="LoadingText" Text="Iniciando FINANCE…"
                           Foreground="#d4af37" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingDetail" Text=""
                           Foreground="#6f685a" FontSize="12" Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- conteúdo -->
        <Grid x:Name="WebViewPanel" Visibility="Collapsed">
            <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#050505"
                          ZoomFactor="1.0"/>
        </Grid>

        <!-- erro fatal (ex.: WebView2 ausente) -->
        <Grid x:Name="ErrorPanel" Visibility="Collapsed" Background="#050505">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        TextBlock.Foreground="#e8e0cf">
                <TextBlock Text="Não foi possível iniciar o FINANCE" FontSize="20" FontWeight="Bold"
                           Foreground="#d4af37" Margin="0,0,0,12"/>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                <TextBlock x:Name="LinkText" TextWrapping="Wrap" FontSize="13" Foreground="#d4af37"
                           Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CopyLink" Content="Copiar link" Click="CopyLink_Click"
                            Padding="14,8" Background="#d4af37" Foreground="#12100b" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
